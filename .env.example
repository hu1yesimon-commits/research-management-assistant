# Default local development stays deterministic and does not enable real providers.
RUNTIME_PROFILE=offline-dev

# Use test only through automated test entrypoints.
# RUNTIME_PROFILE=test

# Real providers are read only when this profile is selected explicitly.
# RUNTIME_PROFILE=real-smoke
# PAPER_JUDGE_PROVIDER=deepseek
# EMBEDDING_PROVIDER=bge-m3
# VECTOR_BACKEND=chroma
# ANSWER_PROVIDER=deepseek
# LEADER_RESPONSE_PROVIDER=deepseek
# SUMMARY_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# OPENAI_API_KEY=
